{
  "name": "nomin-code",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nomin Code — an autonomous engineering workspace, powered by Trion 1.5.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:cli",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=node_modules/.cache/nomin-test.mjs --log-level=warning && node node_modules/.cache/nomin-test.mjs",
    "cli": "node bin/nomin.mjs",
    "tui": "node bin/nomin.mjs",
    "build:cli": "esbuild src/cli/bin.ts --bundle --platform=node --format=esm --target=node20 --outfile=bin/nomin.mjs --banner:js=\"#!/usr/bin/env node\"",
    "prepare": "npm run build:cli"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "@webcontainer/api": "^1.6.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "bin": {
    "nomin": "./bin/nomin.mjs"
  }
}
