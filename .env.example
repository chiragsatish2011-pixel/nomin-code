# Nomin Code — deployment configuration.
#
# Every seat already carries the model it runs on, so a key is all that is
# needed to bring one up. The MODEL variables below are optional overrides,
# for moving a seat onto a different backend without a code change.

# --- Trion 1.5, the worker. Without this key, nothing runs. ---------------
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOMIN_WORKER_MODEL=
# NOMIN_BASE_URL=            # NVIDIA_BASE_URL is still honoured
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- The manager (monitor) -----------------------------------------------
# Its own key, so review traffic never eats the worker budget. Without it,
# reviews run on local evidence alone.
NOMIN_SUPERVISOR_API_KEY=nvapi-...
# NOMIN_SUPERVISOR_MODEL=
# NOMIN_SUPERVISOR_URL=

# --- Vision ---------------------------------------------------------------
# Shares the monitor's seat unless given its own.
# NOMIN_VISION_API_KEY=nvapi-...
# NOMIN_VISION_MODEL=

# --- The doctor team ------------------------------------------------------
# One key each, so six repairs can run without colliding. Roles: 1 diagnosis,
# 2 repair, 3 verification, 4 regression, 5 surface, 6 record.
NOMIN_DOCTOR_1_API_KEY=nvapi-...
NOMIN_DOCTOR_2_API_KEY=nvapi-...
NOMIN_DOCTOR_3_API_KEY=nvapi-...
NOMIN_DOCTOR_4_API_KEY=nvapi-...
NOMIN_DOCTOR_5_API_KEY=nvapi-...
NOMIN_DOCTOR_6_API_KEY=nvapi-...
# NOMIN_DOCTOR_1..6_MODEL=
